# Completed garment GLB / anchors. Auth: VM managed identity.
AZURE_STORAGE_ACCOUNT_URL=https://fitmemlstdev.blob.core.windows.net
AZURE_STORAGE_CONTAINER=garment-glb
# Input models: startup-only download with Azure CLI locally or VM managed identity.
GARMENT_MODELS_ACCOUNT_URL=https://fitmemlstdev.blob.core.windows.net
GARMENT_MODELS_CONTAINER=garment-models
GARMENT_MODEL_CACHE_DIR=/models/cache
# Docker sets GARMENT_MODELS_MANIFEST to the bundled pinned manifest.
# No account key or model-container SAS is required.
# Same storage account; garment VM identity needs read access to body-glb.
BODY_STORAGE_CONTAINER=body-glb
# Parent-process watchdog; first frame includes Cloth initialization.
CLOTH_FIRST_FRAME_TIMEOUT_SECONDS=60
CLOTH_FRAME_TIMEOUT_SECONDS=30
# Total garment mass (kg), NOT mass per vertex. Preview defaults, not measurements.
CLOTH_CREWNECK_TOTAL_MASS_KG=0.2
CLOTH_SLACKS_TOTAL_MASS_KG=0.5
# Azure SQL SQL-authentication; use single quotes for literal $ or # in passwords.
AZURE_SQL_SERVER=YOUR-SERVER.database.windows.net
AZURE_SQL_DATABASE=fitme
AZURE_SQL_USERNAME=YOUR-USER
AZURE_SQL_PASSWORD='REPLACE-ME'
# Optional: full ODBC string takes priority over the four fields above.
AZURE_SQL_CONNECTION_STRING=
# Web VM (10.4.1.4) calls this API over the private network.
VM_BIND_IP=10.4.2.5

# Python uses ODBC Driver 18. Azure VM managed identity (recommended):
# AZURE_SQL_AUTHENTICATION=ActiveDirectoryMsi
# AZURE_SQL_MANAGED_IDENTITY_CLIENT_ID=  # optional user-assigned identity client ID
AZURE_SQL_AUTHENTICATION=ActiveDirectoryMsi
