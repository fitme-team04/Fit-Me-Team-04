# 입어봄 앱 설정 틀 — 이 파일을 복사해 web/.env 로 만들고 값만 바꾸기 (web/.env 는 커밋 안 됨)
# Azure 에 올리면 이 파일 대신 "App Service > 설정 > 환경 변수" 에 같은 이름으로 넣는다

# 데이터 모드: auto(DB 되면 DB, 아니면 데모) / db(DB 만) / demo(데모만)
DATA_MODE=auto

# V2 로컬 HTTP와 Redis. 전달받은 매물·촬영 결과는 MySQL fitme_v2에 저장한다.
APP_PORT=8766
APP_BIND=127.0.0.1
REDIS_URL=redis://127.0.0.1:6380/0
# 워커를 별도 실행할 때 false. bash web/run.sh db, bash web/run.sh media
V2_EMBEDDED_WORKERS=true
# 사이즈코리아 참조용 정제 파일 (WSL 경로). 준비 방법: web/docs/sizekorea.md
SIZEKOREA_REFERENCE_CSV=

# ML팀 의류 평면 치수 추론 POST 주소. 빈 값은 연결 대기, 로컬 테스트는 loopback HTTP 가능.
GARMENT_MEASUREMENT_URL=

# 측정 VM이 보낸 model_blob을 읽을 Azure Blob 컨테이너 URL (선택, 읽기용 SAS 포함 가능)
GARMENT_BLOB_CONTAINER_URL=

# 두 모델을 함께 생성할 때 사용하는 VM의 POST 주소와 종류별 Blob 컨테이너 기본 URL.
# BASE에는 SAS를 넣지 않는다. 각 VM이 완성된 GLB의 개별 읽기 링크를 반환한다.
# 웹 VM 미디어 워커 → 동일 VNet의 신체·의류 FastAPI. 브라우저는 이 주소를 직접 호출하지 않는다.
BODY_MODEL_VM_URL=http://10.4.2.4:8001/api/avatars
GARMENT_MODEL_VM_URL=http://10.4.2.5:8002/api/garments
# 사이즈 판정 /fit. 비우면 GARMENT_MODEL_VM_URL 과 같은 서버의 /fit (예: http://10.4.2.5:8002/fit)
GARMENT_FIT_URL=
BODY_MODEL_BLOB_BASE=https://fitmemlstdev.blob.core.windows.net/body-glb
GARMENT_MODEL_BLOB_BASE=https://fitmemlstdev.blob.core.windows.net/garment-glb
MODEL_PAIR_VM_TIMEOUT_SECONDS=420
# 로그인 프록시와 웹 게이트웨이 사이의 비공개 값. 브라우저에는 보내지 않는다.
# 이미 인증된 ASGI 미들웨어의 사용자 identity를 사용하는 환경에서는 생략한다.
V2_MODEL_INGRESS_TOKEN=

# --- DB (비워 두면 팀 기본값: 127.0.0.1:3306 root / 팀 루트 .env 의 MYSQL_ROOT_PASSWORD) ---
# 내 PC 의 WSL MySQL:              DB_HOST=127.0.0.1
# Azure VM 의 MySQL(VNet 통합):     DB_HOST=<VM 사설 IP 예: 10.0.1.4>
# Azure Database for MySQL:        DB_HOST=<서버이름>.mysql.database.azure.com  + DB_SSL=true
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# --- Azure OpenAI (추천 이유 설명). 셋 다 비우면 템플릿 설명 ---
# 포털 > Azure OpenAI(또는 Microsoft Foundry) 리소스 > 키 및 엔드포인트 / 배포 이름
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
