SAM_PYTHON=/opt/conda/bin/python
# resident: preload once at API startup; oneshot: load per request (rollback).
SAM_RUNTIME_MODE=resident
SAM_CHECKPOINT=/models/sam/model.ckpt
SAM_DETECTOR_DIR=/models/vitdet
SAM_FOV=moge2
SAM_FOV_CHECKPOINT=/models/moge/model.pt
MOMENTUM_ENABLED=0
SAM_MHR=/models/mhr_model.pt
SAM_POSE=/models/a_pose.npz
SAM_BINDING=/models/sam_body.npz
PYTHONPATH=/opt/sam-body
HF_HOME=/models/hf
HF_HUB_OFFLINE=1
# on: SAM 몸은 그대로, Azure ML 치수 28개를 핏 판정용 target으로 붙임(실패 시 SAM 측정값). off: ML 안 부름(기본).
FITME_ML_MEASUREMENTS=off
# azure_ml: real ML; example: no ML request/auth, height-scaled example dimensions.
FITME_PREDICTION_MODE=azure_ml
AZURE_ML_ENDPOINT=
# Must match the endpoint auth_mode. Default: VM managed identity (Entra).
AZURE_ML_AUTH=aad_token
# Only used when AZURE_ML_AUTH=key. Keep the key out of Git.
AZURE_ML_KEY=
# Optional: target a deployment instead of using endpoint traffic routing.
AZURE_ML_DEPLOYMENT=
# Completed avatar GLB / anchors / measurement report. Auth: VM managed identity.
AZURE_STORAGE_ACCOUNT_URL=https://fitmemlstdev.blob.core.windows.net
AZURE_STORAGE_CONTAINER=body-glb
# Web VM (10.4.1.4) calls this API over the private network.
VM_BIND_IP=10.4.2.4
# Blender is launched per measurement/rendering job and exits when done.
