# Copy to .env.models (ignored by Git). Keep the container private.
AZURE_MODELS_ACCOUNT_URL=https://fitmemlstdev.blob.core.windows.net
AZURE_MODELS_CONTAINER=avatar-models
# Required blob names at the container root (all four are downloaded):
# mhr_model.pt, fitme_depth_fixed.blend, a_pose.npz, sam_body.npz
# Preferred on Azure VM: leave secrets empty and grant its managed identity
# Storage Blob Data Reader on avatar-models. Locally DefaultAzureCredential can use az login.
AZURE_MODELS_CONNECTION_STRING=
# Alternative: container SAS with read permission; do not include it in ACCOUNT_URL.
AZURE_MODELS_SAS_TOKEN=
