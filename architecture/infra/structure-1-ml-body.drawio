 id="user-e10" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#2563eb;exitX=1.0000;exitY=0.2083;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.9378;entryDx=0;entryDy=0;opacity=15;" edge="1" parent="1" source="user-gh" target="user-vnet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="860" /><mxPoint x="250" y="560" /></Array></mxGeometry></mxCell><mxCell id="user-e11" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=1.6;strokeColor=#2563eb;exitX=1.0000;exitY=0.6250;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5652;entryDx=0;entryDy=0;opacity=15;" edge="1" parent="1" source="user-gh" target="user-tf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="user-edp" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#2563eb;exitX=1.0000;exitY=0.9167;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;opacity=15;" edge="1" parent="1" source="user-gh" target="user-dep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="928" /><mxPoint x="240" y="965" /><mxPoint x="1435" y="965" /></Array></mxGeometry></mxCell><mxCell id="user-ux" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=1.6;strokeColor=#2563eb;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.6194;entryDx=0;entryDy=0;strokeColor=#ea580c;strokeWidth=2.4;" edge="1" parent="1" source="user-user" target="user-blob"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="94" /><mxPoint x="1600" y="94" /><mxPoint x="1600" y="414" /></Array></mxGeometry></mxCell><mxCell id="user-mi" value="&lt;b&gt;비밀번호 없는 연결 (관리 ID·OIDC)&lt;/b&gt;&lt;br&gt;VM ↔ ACR(AcrPull) · Blob(컨테이너 범위만)&lt;br&gt;의류 VM ↔ SQL(읽기만) · Actions ↔ Azure(OIDC)&lt;br&gt;GLB 링크는 15분 SAS (VM은 서명만, Delegator)&lt;br&gt;&lt;b&gt;지키기&lt;/b&gt;: 삭제 잠금 3개 · Policy 2개(지역·태그)&lt;br&gt;Defender 권장 0건 · 업데이트 점검만" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#475569;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="1150" y="642" width="430" height="125" as="geometry" /></mxCell><mxCell id="user-lg" value="&lt;b&gt;보는 법&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;width:26px;border-top:2px solid #475569;vertical-align:middle&quot;&gt;&lt;/span&gt; 있음·확정&lt;br&gt;&lt;span style=&quot;display:inline-block;width:26px;border-top:2px dashed #94a3b8;vertical-align:middle&quot;&gt;&lt;/span&gt; &lt;span style=&quot;color:#64748b&quot;&gt;예정·확인 필요&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#2563eb&quot;&gt;→&lt;/span&gt; 보내기 · &lt;span style=&quot;color:#2563eb&quot;&gt;↔&lt;/span&gt; 주고받기" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="45" y="560" width="175" height="90" as="geometry" /></mxCell><mxCell id="user-t1" value="① 업로드·옷 선택" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="216.0" y="243" width="108" height="18" as="geometry" /></mxCell><mxCell id="user-t3" value="② 사진·키·몸무게 → ID·링크" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="808.5" y="346" width="203" height="18" as="geometry" /></mxCell><mxCell id="user-t4" value="③ 옷 3D 요청 → ID·링크" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="374.0" y="341" width="192" height="18" as="geometry" /></mxCell><mxCell id="user-tfit" value="/fit 핏 판정 결과" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="602.0" y="353" width="140" height="18" as="geometry" /></mxCell><mxCell id="user-t6" value="⑥ 관리 ID로 읽기만 (실측·이름표)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="705.0" y="591" width="234" height="18" as="geometry" /></mxCell><mxCell id="user-t7" value="④ 13개 → 28개" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1053.5" y="386" width="129" height="18" as="geometry" /></mxCell><mxCell id="user-tsync" value="⑨ 배포 시 모델" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1064.0" y="498" width="108" height="18" as="geometry" /></mxCell><mxCell id="user-tgs" value="⑨ 옷 원본 받기 (시작할 때)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="734.0" y="570" width="192" height="18" as="geometry" /></mxCell><mxCell id="user-tgb" value="⑦ 옷 GLB 저장" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="900.5" y="554" width="119" height="18" as="geometry" /></mxCell><mxCell id="user-t8" value="⑤ 저장" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1082.0" y="474" width="56" height="18" as="geometry" /></mxCell><mxCell id="user-t9" value="SSH 22" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="213.5" y="438" width="77" height="18" as="geometry" /></mxCell><mxCell id="user-t10" value="Terraform" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="196.0" y="791" width="108" height="18" as="geometry" /></mxCell><mxCell id="user-t11" value="state" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="227.0" y="880" width="66" height="18" as="geometry" /></mxCell><mxCell id="user-tdp" value="dev 머지 → ⑩~⑫ 자동 배포" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="578.5" y="956" width="203" height="18" as="geometry" /></mxCell><mxCell id="user-title" value="&lt;b style=&quot;font-size:21px&quot;&gt;구조 1 · ① 사용자 관점 (주황 = 사용자 요청이 지나가는 곳)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#64748b&quot;&gt;① 사진·키·몸무게 업로드, 옷·사이즈 선택 → ② 신체·③ 의류 VM에 동시에 요청 → ④ ML 치수 → ⑤⑦ GLB 저장 → /fit 의류 서버가 핏 판정 → ⑧ 브라우저에 3D 착용 모습 + FIT 결과 (약 18초)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1600" height="46" as="geometry" /></mxCell><mxCell id="user-tux" value="⑧ 브라우저가 15분 링크로 Blob에서 신체·옷 GLB 직접 받아 fit_anchor로 맞춰 3D 표시" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="548.5" y="85" width="623" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ml" name="2. ML 관점"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1010" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ml-ext" value="&lt;b&gt;바깥 (인터넷)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="220" height="930" as="geometry" /></mxCell><mxCell id="ml-user" value="&lt;b&gt;사용자 (웹 브라우저)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;PC·모바일 웹 (앱 없음)&lt;br&gt;신체·옷 GLB를 fit_anchor로&lt;br&gt;맞춰 3D 표시 · 핏 결과&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="180" height="78" as="geometry" /></mxCell><mxCell id="ml-dev" value="&lt;b&gt;팀원·관리자 PC&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;SSH 키 접속, DB는 SSH 터널, 3D VM은 웹 VM 거쳐서&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="180" height="76" as="geometry" /></mxCell><mxCell id="ml-gh" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;팀 레포 (개발용, 비공개)&lt;br&gt;Actions: OIDC 로그인&lt;br&gt;(Contributor 권한만)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="180" height="96" as="geometry" /></mxCell><mxCell id="ml-az" value="&lt;b&gt;Azure · koreacentral · 리소스 그룹 1개 (프로젝트 종료 후 삭제)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf2;strokeColor=#f59e0b;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="1360" height="930" as="geometry" /></mxCell><mxCell id="ml-vnet" value="&lt;b&gt;VNet fitme-vnet-dev · 10.4.0.0/16 (Terraform으로만 수정) · 서브넷 3개 (snet-data 10.4.3.0/24는 DB용 예비, 비어 있음)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#3b82f6;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="280" y="108" width="830" height="482" as="geometry" /></mxCell><mxCell id="ml-sf" value="&lt;b&gt;snet-front 10.4.1.0/24 · NSG fitme-nsg-front-dev (인터넷 443·80, SSH 22는 팀 IP만)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=11;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="300" y="145" width="790" height="195" as="geometry" /></mxCell><mxCell id="ml-pip" value="&lt;b&gt;공인 IP fitme-pip-dev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;고정 IP + 무료 DNS 이름&lt;br&gt;https 주소 1개&lt;br&gt;(주소는 가림)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="320" y="230" width="165" height="70" as="geometry" /></mxCell><mxCell id="ml-web" value="&lt;b&gt;웹 VM fitme-vm-web-dev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;Ubuntu 24.04 · B2als_v2 (4GB) · Docker compose (app·redis) · 바깥에 열린 포트는 nginx 80·443만&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;arcSize=4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="500" y="180" width="570" height="145" as="geometry" /></mxCell><mxCell id="ml-nginx" value="&lt;b&gt;nginx (VM에 설치)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;https·로그인 → 웹앱&lt;br&gt;/api/health만 로그인 없음&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="512" y="230" width="150" height="75" as="geometry" /></mxCell><mxCell id="ml-fe" value="&lt;b&gt;웹앱 FastAPI :8766&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;화면(HTML·JS) + API&lt;br&gt;미디어 워커(3D·/fit 호출)&lt;br&gt;ease_check (키·몸무게 추정)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="678" y="230" width="190" height="75" as="geometry" /></mxCell><mxCell id="ml-redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;3D 생성&lt;br&gt;요청 줄 세우기&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="876" y="230" width="184" height="75" as="geometry" /></mxCell><mxCell id="ml-sb" value="&lt;b&gt;snet-back 10.4.2.0/24 · NSG fitme-nsg-back-dev (snet-front에서 8001·8002·22만)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#c084fc;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=11;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="790" height="200" as="geometry" /></mxCell><mxCell id="ml-gvm" value="&lt;b&gt;의류 CPU VM fitme-vm-garment-dev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;B2als_v2 · 10.4.2.5 · 약 65원/시간 · ACR 자동 배포&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;arcSize=4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="320" y="412" width="260" height="140" as="geometry" /></mxCell><mxCell id="ml-gapi" value="&lt;b&gt;의류 API :8002&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;③ 옷 3D 요청&lt;br&gt;/fit 핏 판정&lt;br&gt;⑥ SQL 읽기&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="332" y="462" width="118" height="75" as="geometry" /></mxCell><mxCell id="ml-gbl" value="&lt;b&gt;Blender 4.3.2&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;⑨ 옷 원본으로&lt;br&gt;옷 만들기&lt;br&gt;→ ⑦ GLB 저장&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="456" y="462" width="112" height="75" as="geometry" /></mxCell><mxCell id="ml-bvm" value="&lt;b&gt;신체 GPU VM fitme-vm-body-dev (동작 중, 한 번에 1건 · 약 18초)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;T4 16GB · Ubuntu 22.04 · 10.4.2.4 · 약 900원/시간, 안 쓰면 꺼둠 · 손 배포&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;arcSize=4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;strokeColor=#16a34a;strokeWidth=2.6;" vertex="1" parent="1"><mxGeometry x="660" y="412" width="410" height="140" as="geometry" /></mxCell><mxCell id="ml-bapi" value="&lt;b&gt;신체 API :8001&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;② 요청 받기&lt;br&gt;④ ML 호출&lt;br&gt;(13개 → 28개)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;strokeColor=#16a34a;strokeWidth=2.6;" vertex="1" parent="1"><mxGeometry x="672" y="462" width="122" height="75" as="geometry" /></mxCel