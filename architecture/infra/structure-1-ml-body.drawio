p;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;arcSize=4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;strokeColor=#ea580c;strokeWidth=2.6;" vertex="1" parent="1"><mxGeometry x="1150" y="318" width="430" height="155" as="geometry" /></mxCell><mxCell id="user-av" value="&lt;b&gt;body-glb&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;신체 GLB&lt;br&gt;기준점·둘레&lt;br&gt;1일 뒤 삭제&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;strokeColor=#ea580c;strokeWidth=2.6;" vertex="1" parent="1"><mxGeometry x="1162" y="368" width="98" height="92" as="geometry" /></mxCell><mxCell id="user-mdl" value="&lt;b&gt;avatar-models&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;신체 모델 4개&lt;br&gt;배포 때 확인&lt;br&gt;(읽기 전용)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;strokeColor=#ea580c;strokeWidth=2.6;" vertex="1" parent="1"><mxGeometry x="1266" y="368" width="98" height="92" as="geometry" /></mxCell><mxCell id="user-ga" value="&lt;b&gt;garment-glb&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;옷 GLB&lt;br&gt;fit_anchor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;strokeColor=#ea580c;strokeWidth=2.6;" vertex="1" parent="1"><mxGeometry x="1370" y="368" width="98" height="92" as="geometry" /></mxCell><mxCell id="user-gm" value="&lt;b&gt;garment-models&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;옷 원본 5개&lt;br&gt;시작할 때 받기&lt;br&gt;(읽기 전용)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;strokeColor=#ea580c;strokeWidth=2.6;" vertex="1" parent="1"><mxGeometry x="1474" y="368" width="98" height="92" as="geometry" /></mxCell><mxCell id="user-kv" value="&lt;b&gt;Key Vault fitme-kv-dev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;ml-endpoint-key (유일한 비밀값)&lt;br&gt;접근 기록 → fitme-log-dev&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="1150" y="535" width="205" height="95" as="geometry" /></mxCell><mxCell id="user-acr" value="&lt;b&gt;ACR fitmeacrdev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;fitme-web · fitme-garment&lt;br&gt;신체는 VM 안에서 빌드&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="1375" y="535" width="205" height="95" as="geometry" /></mxCell><mxCell id="user-ops" value="&lt;b&gt;운영·관리&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="280" y="790" width="1320" height="190" as="geometry" /></mxCell><mxCell id="user-tf" value="&lt;b&gt;Terraform 장부 fitmetfstatedev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;Storage · tfstate&lt;br&gt;삭제 잠금 · 버전 보관&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="300" y="835" width="200" height="115" as="geometry" /></mxCell><mxCell id="user-dep" value="&lt;b&gt;자동 배포 (웹·의류)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;dev 머지 → ⑩ Actions가 이미지 빌드 → ACR&lt;br&gt;→ ⑪ Run Command로 VM 교체&lt;br&gt;→ ⑫ VM이 ACR에서 받기&lt;br&gt;신체는 손 배포 (자동화는 발표 후)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColo