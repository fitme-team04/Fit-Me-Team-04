;entryY=0.5652;entryDx=0;entryDy=0;" edge="1" parent="1" source="all-gh" target="all-tf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-edp" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#2563eb;exitX=1.0000;exitY=0.9167;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="all-gh" target="all-dep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="928" /><mxPoint x="240" y="965" /><mxPoint x="1435" y="965" /></Array></mxGeometry></mxCell><mxCell id="all-ux" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=1.6;strokeColor=#2563eb;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.6194;entryDx=0;entryDy=0;" edge="1" parent="1" source="all-user" target="all-blob"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="94" /><mxPoint x="1600" y="94" /><mxPoint x="1600" y="414" /></Array></mxGeometry></mxCell><mxCell id="all-title" value="&lt;b style=&quot;font-size:21px&quot;&gt;구조 1 · ML 치수로 3D 몸 만들기 (발표 때 구조)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#64748b&quot;&gt;사용: ① 업로드·옷 선택 → ② 신체 / ③ 의류 요청 (동시에) → ④ ML 치수 28개 → ⑤⑦ GLB 저장 → /fit 의류 서버가 핏 판정 → ⑧ 브라우저가 신체·옷 GLB 받아 3D 표시 · ⑨ 모델 받기 · ⑩~⑫ 배포&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1600" height="46" as="geometry" /></mxCell><mxCell id="all-mi" value="&lt;b&gt;비밀번호 없는 연결 (관리 ID·OIDC)&lt;/b&gt;&lt;br&gt;VM ↔ ACR(AcrPull) · Blob(컨테이너 범위만)&lt;br&gt;의류 VM ↔ SQL(읽기만) · Actions ↔ Azure(OIDC)&lt;br&gt;GLB 링크는 15분 SAS (VM은 서명만, Delegator)&lt;br&gt;&lt;b&gt;지키기&lt;/b&gt;: 삭제 잠금 3개 · Policy 2개(지역·태그)&lt;br&gt;Defender 권장 0건 · 업데이트 점검만" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1150" y="642" width="430" height="125" as="geometry" /></mxCell><mxCell id="all-lg" value="&lt;b&gt;보는 법&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;width:26px;border-top:2px solid #475569;vertical-align:middle&quot;&gt;&lt;/span&gt; 있음·확정&lt;br&gt;&lt;span style=&quot;display:inline-block;width:26px;border-top:2px dashed #94a3b8;vertical-align:middle&quot;&gt;&lt;/span&gt; &lt;span style=&quot;color:#64748b&quot;&gt;예정·확인 필요&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#2563eb&quot;&gt;→&lt;/span&gt; 보내기 · &lt;span style=&quot;color:#2563eb&quot;&gt;↔&lt;/span&gt; 주고받기" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="45" y="560" width="175" height="90" as="geometry" /></mxCell><mxCell id="all-t1" value="① 업로드·옷 선택" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="216.0" y="243" width="108" height="18" as="geometry" /></mxCell><mxCell id="all-t3" value="② 사진·키·몸무게 → ID·링크" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="808.5" y="346" width="203" height="18" as="geometry" /></mxCell><mxCell id="all-t4" value="③ 옷 3D 요청 → ID·링크" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="374.0" y="341" width="192" height="18" as="geometry" /></mxCell><mxCell id="all-tfit" value="/fit 핏 판정 결과" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="602.0" y="353" width="140" height="18" as="geometry" /></mxCell><mxCell id="all-t6" value="⑥ 관리 ID로 읽기만 (실측·이름표)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="705.0" y="591" width="234" height="18" as="geometry" /></mxCell><mxCell id="all-t7" value="④ 13개 → 28개" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1053.5" y="386" width="129" height="18" as="geometry" /></mxCell><mxCell id="all-tsync" value="⑨ 배포 시 모델" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1064.0" y="498" width="108" height="18" as="geometry" /></mxCell><mxCell id="all-tgs" value="⑨ 옷 원본 받기 (시작할 때)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="734.0" y="570" width="192" height="18" as="geometry" /></mxCell><mxCell id="all-tgb" value="⑦ 옷 GLB 저장" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="900.5" y="554" width="119" height="18" as="geometry" /></mxCell><mxCell id="all-t8" value="⑤ 저장" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1082.0" y="474" width="56" height="18" as="geometry" /></mxCell><mxCell id="all-t9" value="SSH 22" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="213.5" y="438" width="77" height="18" as="geometry" /></mxCell><mxCell id="all-t10" value="Terraform" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeome