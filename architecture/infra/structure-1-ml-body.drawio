span style=&quot;color:#64748b&quot;&gt;예정·확인 필요&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#2563eb&quot;&gt;→&lt;/span&gt; 보내기 · &lt;span style=&quot;color:#2563eb&quot;&gt;↔&lt;/span&gt; 주고받기" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="45" y="560" width="175" height="90" as="geometry" /></mxCell><mxCell id="fe-t1" value="① 업로드·옷 선택" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="216.0" y="243" width="108" height="18" as="geometry" /></mxCell><mxCell id="fe-t3" value="② 사진·키·몸무게 → ID·링크" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="808.5" y="346" width="203" height="18" as="geometry" /></mxCell><mxCell id="fe-t4" value="③ 옷 3D 요청 → ID·링크" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="374.0" y="341" width="192" height="18" as="geometry" /></mxCell><mxCell id="fe-tfit" value="/fit 핏 판정 결과" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="602.0" y="353" width="140" height="18" as="geometry" /></mxCell><mxCell id="fe-t6" value="⑥ 관리 ID로 읽기만 (실측·이름표)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="705.0" y="591" width="234" height="18" as="geometry" /></mxCell><mxCell id="fe-t7" value="④ 13개 → 28개" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="1053.5" y="386" width="129" height="18" as="geometry" /></mxCell><mxCell id="fe-tsync" value="⑨ 배포 시 모델" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1064.0" y="498" width="108" height="18" as="geometry" /></mxCell><mxCell id="fe-tgs" value="⑨ 옷 원본 받기 (시작할 때)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="734.0" y="570" width="192" height="18" as="geometry" /></mxCell><mxCell id="fe-tgb" value="⑦ 옷 GLB 저장" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="900.5" y="554" width="119" height="18" as="geometry" /></mxCell><mxCell id="fe-t8" value="⑤ 저장" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="1082.0" y="474" width="56" height="18" as="geometry" /></mxCell><mxCell id="fe-t9" value="SSH 22" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="213.5" y="438" width="77" height="18" as="geometry" /></mxCell><mxCell id="fe-t10" value="Terraform" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="196.0" y="791" width="108" height="18" as="geometry" /></mxCell><mxCell id="fe-t11" value="state" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="227.0" y="880" width="66" height="18" as="geometry" /></mxCell><mxCell id="fe-tdp" value="dev 머지 → ⑩~⑫ 자동 배포" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="578.5" y="956" width="203" height="18" as="geometry" /></mxCell><mxCell id="fe-title" value="&lt;b style=&quot;font-size:21px&quot;&gt;구조 1 · ④ 프론트 관점 (파랑 = 프론트 담당이 맡는 곳과 통신)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#64748b&quot;&gt;① https·로그인 → 웹앱 · 사진은 브라우저에서 1920px로 줄임 · 미디어 워커가 ② 신체·③ 의류에 동시에 요청 → 신체 결과 뒤 /fit 핏 판정 받기 → ⑧ 브라우저가 신체·옷 GLB를 fit_anchor로 맞춰 표시 · ⑩~⑫ 자동 배포&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1600" height="46" as="geometry" /></mxCell><mxCell id="fe-tux" value="⑧ 브라우저가 15분 링크로 Blob에서 신체·옷 GLB 직접 받아 fit_anchor로 맞춰 3D 표시" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#334155;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="548.5" y="85" width="623" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>