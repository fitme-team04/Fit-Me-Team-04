width="112" height="75" as="geometry" /></mxCell><mxCell id="fe-bvm" value="&lt;b&gt;신체 GPU VM fitme-vm-body-dev (동작 중, 한 번에 1건 · 약 18초)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;T4 16GB · Ubuntu 22.04 · 10.4.2.4 · 약 900원/시간, 안 쓰면 꺼둠 · 손 배포&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;arcSize=4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;strokeColor=#2563eb;strokeWidth=2.6;" vertex="1" parent="1"><mxGeometry x="660" y="412" width="410" height="140" as="geometry" /></mxCell><mxCell id="fe-bapi" value="&lt;b&gt;신체 API :8001&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;② 요청 받기&lt;br&gt;④ ML 호출&lt;br&gt;(13개 → 28개)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;strokeColor=#2563eb;strokeWidth=2.6;" vertex="1" parent="1"><mxGeometry x="672" y="462" width="122" height="75" as="geometry" /></mxCell><mxCell id="fe-sam" value="&lt;b&gt;SAM 3D Body&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;사진 → 3D 몸 복원&lt;br&gt;GPU에 상주&lt;br&gt;(켤 때 1번 37초)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="800" y="462" width="128" height="75" as="geometry" /></mxCell><mxCell id="fe-bl" value="&lt;b&gt;Blender&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;몸 치수 11개 재기&lt;br&gt;ML 치수로 변형&lt;br&gt;→ ⑤ GLB 저장&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;opacity=20;textOpacity=20;" vertex="1" parent="1"><mxGeometry x="934" y="462" width="124" height="75" as="geometry" /></mxCell><mxCell id="fe-mysql" value="&lt;b&gt;SQL Server fitme-sql-dev · DB fitme (의류 VM만 읽음)&lt;/b&gt;&lt;br&gt;&lt;font s