<mxfile host="app.diagrams.net"><diagram id="all" name="0. 전체 구조"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1010" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="all-ext" value="&lt;b&gt;바깥 (인터넷)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="220" height="930" as="geometry" /></mxCell><mxCell id="all-user" value="&lt;b&gt;사용자 (웹 브라우저)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;PC·모바일 웹 (앱 없음)&lt;br&gt;신체·옷 GLB를 fit_anchor로&lt;br&gt;맞춰 3D 표시 · 핏 결과&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="180" height="78" as="geometry" /></mxCell><mxCell id="all-dev" value="&lt;b&gt;팀원·관리자 PC&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;SSH 키 접속, DB는 SSH 터널, 3D VM은 웹 VM 거쳐서&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="180" height="76" as="geometry" /></mxCell><mxCell id="all-gh" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;팀 레포 (개발용, 비공개)&lt;br&gt;Actions: OIDC 로그인&lt;br&gt;(Contributor 권한만)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="180" height="96" as="geometry" /></mxCell><mxCell id="all-az" value="&lt;b&gt;Azure · koreacentral · 리소스 그룹 1개 (프로젝트 종료 후 삭제)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf2;strokeColor=#f59e0b;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="1360" height="930" as="geometry" /></mxCell><mxCell id="all-vnet" value="&lt;b&gt;VNet fitme-vnet-dev · 10.4.0.0/16 (Terraform으로만 수정) · 서브넷 3개 (snet-data 10.4.3.0/24는 DB용 예비, 비어 있음)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#3b82f6;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="280" y="108" width="830" height="482" as="geometry" /></mxCell><mxCell id="all-sf" value="&lt;b&gt;snet-front 10.4.1.0/24 · NSG fitme-nsg-front-dev (인터넷 443·80, SSH 22는 팀 IP만)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=11;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="300" y="145" width="790" height="195" as="geometry" /></mxCell><mxCell id="all-pip" value="&lt;b&gt;공인 IP fitme-pip-dev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;고정 IP + 무료 DNS 이름&lt;br&gt;https 주소 1개&lt;br&gt;(주소는 가림)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="230" width="165" height="70" as="geometry" /></mxCell><mxCell id="all-web" value="&lt;b&gt;웹 VM fitme-vm-web-dev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;Ubuntu 24.04 · B2als_v2 (4GB) · Docker compose (app·redis) · 바깥에 열린 포트는 nginx 80·443만&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;arcSize=4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="180" width="570" height="145" as="geometry" /></mxCell><mxCell id="all-nginx" value="&lt;b&gt;nginx (VM에 설치)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;https·로그인 → 웹앱&lt;br&gt;/api/health만 로그인 없음&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="512" y="230" width="150" height="75" as="geometry" /></mxCell><mxCell id="all-fe" value="&lt;b&gt;웹앱 FastAPI :8766&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;화면(HTML·JS) + API&lt;br&gt;미디어 워커(3D·/fit 호출)&lt;br&gt;ease_check (키·몸무게 추정)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="678" y="230" width="190" height="75" as="geometry" /></mxCell><mxCell id="all-redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;3D 생성&lt;br&gt;요청 줄 세우기&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="876" y="230" width="184" height="75" as="geometry" /></mxCell><mxCell id="all-sb" value="&lt;b&gt;snet-back 10.4.2.0/24 · NSG fitme-nsg-back-dev (snet-front에서 8001·8002·22만)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#c084fc;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=11;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="790" height="200" as="geometry" /></mxCell><mxCell id="all-gvm" value="&lt;b&gt;의류 CPU VM fitme-vm-garment-dev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;B2als_v2 · 10.4.2.5 · 약 65원/시간 · ACR 자동 배포&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;arcSize=4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="412" width="260" height="140" as="geometry" /></mxCell><mxCell id="all-gapi" value="&lt;b&gt;의류 API :8002&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;③ 옷 3D 요청&lt;br&gt;/fit 핏 판정&lt;br&gt;⑥ SQL 읽기&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="332" y="462" width="118" height="75" as="geometry" /></mxCell><mxCell id="all-gbl" value="&lt;b&gt;Blender 4.3.2&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;⑨ 옷 원본으로&lt;br&gt;옷 만들기&lt;br&gt;→ ⑦ GLB 저장&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="456" y="462" width="112" height="75" as="geometry" /></mxCell><mxCell id="all-bvm" value="&lt;b&gt;신체 GPU VM fitme-vm-body-dev (동작 중, 한 번에 1건 · 약 18초)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;T4 16GB · Ubuntu 22.04 · 10.4.2.4 · 약 900원/시간, 안 쓰면 꺼둠 · 손 배포&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;arcSize=4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="412" width="410" height="140" as="geometry" /></mxCell><mxCell id="all-bapi" value="&lt;b&gt;신체 API :8001&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;② 요청 받기&lt;br&gt;④ ML 호출&lt;br&gt;(13개 → 28개)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="672" y="462" width="122" height="75" as="geometry" /></mxCell><mxCell id="all-sam" value="&lt;b&gt;SAM 3D Body&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;사진 → 3D 몸 복원&lt;br&gt;GPU에 상주&lt;br&gt;(켤 때 1번 37초)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="462" width="128" height="75" as="geometry" /></mxCell><mxCell id="all-bl" value="&lt;b&gt;Blender&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;몸 치수 11개 재기&lt;br&gt;ML 치수로 변형&lt;br&gt;→ ⑤ GLB 저장&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="934" y="462" width="124" height="75" as="geometry" /></mxCell><mxCell id="all-mysql" value="&lt;b&gt;SQL Server fitme-sql-dev · DB fitme (의류 VM만 읽음)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;VNet 밖·방화벽 · 무료 서버리스 · 삭제 잠금&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;arcSize=4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="612" width="790" height="152" as="geometry" /></mxCell><mxCell id="all-sqldb" value="&lt;b&gt;body (몸 치수 자료)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;measures · poses · profiles&lt;br&gt;size_fitme · users&lt;br&gt;학습 원본 보관 (ML은 CSV로 학습)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="664" width="240" height="86" as="geometry" /></mxCell><mxCell id="all-sqlg" value="&lt;b&gt;garment (옷 자료) ⑥&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;brands · garments · measures · sizes&lt;br&gt;size_musinsa_standard&lt;br&gt;size_topten · size_ziozia&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="664" width="240" height="86" as="geometry" /></mxCell><mxCell id="all-sqlref" value="&lt;b&gt;ref (치수 이름표) ⑥&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;measure_aliases&lt;br&gt;measure_definitions · measure_maps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="664" width="240" height="86" as="geometry" /></mxCell><mxCell id="all-svc" value="&lt;b&gt;VNet 밖 Azure 서비스&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1130" y="108" width="470" height="662" as="geometry" /></mxCell><mxCell id="all-aml" value="&lt;b&gt;Azure ML fitme-mlw-dev&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;arcSize=4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="145" width="430" height="155" as="geometry" /></mxCell><mxCell id="all-ep" value="&lt;b&gt;관리형 엔드포인트 fitme-ml-v3&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;T4 1대 · 키 인증 · 켠 동안 과금&lt;br&gt;model-c + model-s (빈 값 채움)&lt;br&gt;13개 → 치수 28개&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1165" y="190" width="195" height="95" as="geometry" /></mxCell><mxCell id="all-cl" value="&lt;b&gt;fitme-cpu-cluster&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;Designer 데이터 정제·학습&lt;br&gt;최소 0대 (쓴 시간만 과금)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1370" y="190" width="195" height="95" as="geometry" /></mxCell><mxCell id="all-blob" value="&lt;b&gt;Storage fitmemlstdev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;ML 저장소와 같이 씀 · 비공개 · CORS: 웹 주소 GET · 삭제 잠금&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;arcSize=4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="318" width="430" height="155" as="geometry" /></mxCell><mxCell id="all-av" value="&lt;b&gt;body-glb&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;신체 GLB&lt;br&gt;기준점·둘레&lt;br&gt;1일 뒤 삭제&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1162" y="368" width="98" height="92" as="geometry" /></mxCell><mxCell id="all-mdl" value="&lt;b&gt;avatar-models&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;신체 모델 4개&lt;br&gt;배포 때 확인&lt;br&gt;(읽기 전용)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1266" y="368" width="98" height="92" as="geometry" /></mxCell><mxCell id="all-ga" value="&lt;b&gt;garment-glb&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;옷 GLB&lt;br&gt;fit_anchor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1370" y="368" width="98" height="92" as="geometry" /></mxCell><mxCell id="all-gm" value="&lt;b&gt;garment-models&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;옷 원본 5개&lt;br&gt;시작할 때 받기&lt;br&gt;(읽기 전용)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1474" y="368" width="98" height="92" as="geometry" /></mxCell><mxCell id="all-kv" value="&lt;b&gt;Key Vault fitme-kv-dev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;ml-endpoint-key (유일한 비밀값)&lt;br&gt;접근 기록 → fitme-log-dev&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="535" width="205" height="95" as="geometry" /></mxCell><mxCell id="all-acr" value="&lt;b&gt;ACR fitmeacrdev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;fitme-web · fitme-garment&lt;br&gt;신체는 VM 안에서 빌드&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1375" y="535" width="205" height="95" as="geometry" /></mxCell><mxCell id="all-ops" value="&lt;b&gt;운영·관리&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="280" y="790" width="1320" height="190" as="geometry" /></mxCell><mxCell id="all-tf" value="&lt;b&gt;Terraform 장부 fitmetfstatedev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;Storage · tfstate&lt;br&gt;삭제 잠금 · 버전 보관&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="835" width="200" height="115" as="geometry" /></mxCell><mxCell id="all-dep" value="&lt;b&gt;자동 배포 (웹·의류)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;dev 머지 → ⑩ Actions가 이미지 빌드 → ACR&lt;br&gt;→ ⑪ Run Command로 VM 교체&lt;br&gt;→ ⑫ VM이 ACR에서 받기&lt;br&gt;신체는 손 배포 (자동화는 발표 후)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="835" width="290" height="115" as="geometry" /></mxCell><mxCell id="all-bud" value="&lt;b&gt;예산 fitme-budget&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;월 80만 원 · 11/30까지&lt;br&gt;50·75·100% + 예측 100%&lt;br&gt;매일 비용 메일&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="515" y="835" width="185" height="115" as="geometry" /></mxCell><mxCell id="all-al" value="&lt;b&gt;알림 12개 → fitme-ag-dev 메일&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;권한·잠금·Key Vault·NSG·VM 삭제&lt;br&gt;CPU 80%·메모리 부족·VM 장애&lt;br&gt;GPU VM 켜짐 · 사이트 접속 실패&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="715" y="835" width="225" height="115" as="geometry" /></mxCell><mxCell id="all-mon" value="&lt;b&gt;모니터링&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;Log Analytics fitme-log-dev (하루 1GB · 30일)&lt;br&gt;VM Insights 3대 · Key Vault 접근 기록&lt;br&gt;App Insights fitme-appi-dev: /api/health 5분마다&lt;br&gt;대시보드 fitme-ops-dev&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="955" y="835" width="320" height="115" as="geometry" /></mxCell><mxCell id="all-e1" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=1.6;strokeColor=#2563eb;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="all-user" target="all-pip"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e2" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;start