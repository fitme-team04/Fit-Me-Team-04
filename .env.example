# PoC 실행 설정 틀 (로컬 PC·VM 공통). .env 가 없으면 setup.sh 가 이 파일을 .env 로 복사, 환경마다 다른 값만 .env 에서 바꾸기
# 실행 위치: 저장소를 여기로 복사해 실행 (로컬·VM 기본값 같음 → 어디서나 cd ~/poc-size-ai, ~ 대신 $HOME: 절대경로로 펼쳐짐)
# 저장소 경로로 두면 복사 없이 그 자리에서 실행 (경로에 공백 있으면 "..." 로 감싸기)
APP_DIR=$HOME/poc-size-ai
# MySQL 컨테이너 이름
DB_CONTAINER=poc-mysql
# 데이터 보존 볼륨 이름
DB_VOLUME=poc-mysql-data
# MySQL 이미지
DB_IMAGE=mysql:8.0
# 포트를 여는 주소: 127.0.0.1 = 이 컴퓨터 안에서만 접속 (0.0.0.0 은 외부 공개, 컨테이너 처음 만들 때만 적용)
DB_BIND=127.0.0.1
# 호스트 포트
DB_PORT=3306
# root 비밀번호 (PoC 기본값, 컨테이너 처음 만들 때만 적용)
MYSQL_ROOT_PASSWORD=poc-root
# 입어봄 V2 웹앱 포트
APP_PORT=8766
# 웹앱을 여는 주소: 127.0.0.1 = 이 컴퓨터 안에서만 (WSL 은 Windows 브라우저에서도 열림). VM 에서 밖으로 열 때만 0.0.0.0
APP_BIND=127.0.0.1
